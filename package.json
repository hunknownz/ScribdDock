{
  "name": "scribddock",
  "version": "0.1.0",
  "description": "A local CLI for the Scribd family of sources",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.15"
  },
  "packageManager": "pnpm@11.19.0",
  "bin": {
    "scribddock": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:live": "SCRIBD_LIVE=1 vitest run tests/live-scribd.test.ts",
    "test:browser": "SCRIBD_BROWSER=1 vitest run tests/browser.test.ts",
    "browser:install": "tsx scripts/install-browser.ts"
  },
  "dependencies": {
    "camoufox": "0.5.8",
    "commander": "15.0.0",
    "pdf-lib": "1.17.1",
    "playwright-core": "1.62.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^24.19.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
